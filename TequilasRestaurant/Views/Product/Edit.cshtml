@using TequilasRestaurant.Models.DbModels
@model Product

@{
	ViewBag.Title = $"Edit Product";
}

<h1>Edit @Model.Name Item</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
	<input type="hidden" asp-for="ProductId" value="@Model.ProductId" />

	<div class="form-group">
		<label asp-for="Name"></label>
		<input type="text" asp-for="Name" class="form-control" value="@Model.Name" />
		<span asp-validation-for="Name" class="text-danger"></span>
	</div>

	<div class="form-group">
		<label asp-for="Description"></label>
		<input type="text" asp-for="Description" class="form-control" value="@Model.Description"/>
		<span asp-validation-for="Description" class="text-danger"></span>
	</div>

	<div class="form-group">
		<label asp-for="Price"></label>
		<input type="number" asp-for="Price" class="form-control" value="@Model.Price"/>
		<span asp-validation-for="Price" class="text-danger"></span>
	</div>

	<div class="form-group">
		<label asp-for="Stock"></label>
		<input type="number" asp-for="Stock" class="form-control" value="@Model.Stock"/>
		<span asp-validation-for="Stock" class="text-danger"></span>
	</div>

	<div class="form-group">
		<label for="imageUpload">Upload Image</label>
		<input type="file" class="form-control" asp-for="ImageFile" />
	</div>

	<div class="row mt-3">
		<div class="col">
			@foreach (Category category in ViewBag.Categories)
			{
				<div class="form-check">
					@{
						bool isChecked = Model.CategoryId == category.CategoryId;
					}
					<input type="radio" class="form-check-input" id="@category.CategoryId" name="CategoryId" value="@category.CategoryId" @(isChecked ? "checked" : "") /> @category.Name
				</div>
			}
		</div>

		<div class="col">
			@foreach (Ingredient ingredient in ViewBag.Ingredients)
			{
				<div class="form-check">
					@{
						bool isChecked = Model.ProductIngredients != null && Model.ProductIngredients.Any(i => i.IngredientId == ingredient.IngredientId);
					}

					<input type="checkbox" class="form-check-input" id="@ingredient.IngredientId" name="ingredientIds" value="@ingredient.IngredientId" @(isChecked ? "checked" : "") /> @ingredient.Name
				</div>
			}
		</div>
	</div>

	<button type="submit" class="btn btn-primary">Save</button>
	<a asp-action="Index" asp-controller="Product" class="btn btn-secondary">Cancel</a>
</form>