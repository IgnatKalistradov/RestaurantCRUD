@using System.Globalization
@using TequilasRestaurant.Models.DbModels
@model IEnumerable<Product>
@{
	ViewBag.Title = "Products";
}

<script src="~/js/product/index.js"></script>

<h2>Restaurant menu</h2>

<a asp-action="Add" asp-controller="Product" class="btn btn-primary mt-2 mb-5">Create New Item</a>

<div class="row">
@foreach(Product product in Model)
{
	<div class="col-md-4 mb-5">
		<div class="card">
			<img src="@Url.Content("~/images/" + product?.ImageUrl)" class="card-img-top fixed-image-height" alt="@product.Description"/>
			<div class="card-body">
				<h5 class="card-title">@product.Name</h5>
				<p class="card-text">@product.Description</p>
				<p class="card-text">@product.Price.ToString("C", new CultureInfo("uk-UA"))</p>
				<p class="card-text">Кількість: @product.Stock</p>
			</div>
			<div class="card-footer">
				<a asp-action="Details" asp-controller="Product" asp-route-id="@product.ProductId" class="btn btn-outline-dark">Details</a>
				<a asp-action="Edit" asp-controller="Product" asp-route-id="@product.ProductId" class="btn btn-outline-dark">Edit</a>
				<button type="button" class="btn btn-outline-danger delete-button" data-bs-toggle="modal" data-bs-target="#staticBackdrop" data-product-id="@product.ProductId" data-product-name="@product.Name">Delete</button>
			</div>
		</div>
	</div>	
}
</div>

<!-- Modal -->
<div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<div class="modal-header">
				<h1 class="modal-title fs-5" id="staticBackdropLabel"></h1>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
				<form asp-action="Delete" asp-controller="Product" asp-route-id="1" method="post" id="deleteProductForm">
					<input type="hidden" name="ProductId" id="productIdInput" value="" />
					<button type="submit" class="btn btn-outline-danger" id="modalConfirmButton">Delete</button>
				</form>
			</div>
		</div>
	</div>
</div>