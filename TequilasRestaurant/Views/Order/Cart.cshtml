@using System.Globalization
@using TequilasRestaurant.Models.ViewModels
@model OrderViewModel

@{
	ViewBag.Title = "Cart";
}

<h1>My Cart</h1>


	<table class="table table-bordered">
		<thead>
			<tr>
				<th>Product</th>
				<th>Quantity</th>
				<th>Price per unit</th>
				<th>Total price</th>
				<th></th>
			</tr>
		</thead>
		<tbody>
			@foreach(OrderItemViewModel orderItem in Model.OrderItems)
			{
				<tr>
					<td>@orderItem.ProductName</td>
					<td>@orderItem.Quantity</td>
					<td>@orderItem.PricePerUnit</td>
					<td>@(orderItem.PricePerUnit * orderItem.Quantity)</td>
					<td>
						<form asp-action="RemoveItem" asp-controller="Order" method="post">
							<input type="hidden" name="productId" value="@orderItem.ProductId"/>
						<button type="submit" class="btn btn-outline-danger">
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
								<path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"></path>
								<path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"></path>
							</svg>
							Remove
						</button>
						</form>
					</td>
				</tr>
			}
		</tbody>

		
	</table>

<h3>
	Total Amount: @Model.TotalAmount.ToString("C", new CultureInfo("uk-UA"))
</h3>

<form asp-action="Place" asp-controller="Order" method="post">
	<button class="btn btn-primary" type="submit">Place Order</button>
</form>

