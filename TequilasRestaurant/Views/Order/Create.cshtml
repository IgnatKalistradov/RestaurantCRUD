@using System.Globalization
@using TequilasRestaurant.Models.DbModels
@using TequilasRestaurant.Models.ViewModels
@model OrderViewModel

@{
	ViewBag.Title = "Create Order";
}

<h1>Create Order</h1>

<div class="row">
	@foreach(Product product in Model.Products)
	{
		<div class="col-md-4 mb-3">
			<form asp-action="AddItem" method="post">
				<div class="card" style="width: 18rem;">
					<img src="@Url.Content("~/images/" + product?.ImageUrl)" class="card-img-top fixed-image-height" alt="@product.Description"/>
					<div class="card-body">
						@product.Name - @product.Price.ToString("C", new CultureInfo("uk-UA"))
						<input type="hidden" value="@product.ProductId" name="productId"/>
						<input type="number" name="productQuantity" class="form-control"/>
					</div>
					<div class="card-footer">
						<button class="btn btn-info" type="submit">Add</button>
					</div>
				</div>
			</form>
		</div>
	}
</div>
