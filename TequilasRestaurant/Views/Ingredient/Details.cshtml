@using TequilasRestaurant.Models.DbModels
@model TequilasRestaurant.Models.DbModels.Ingredient;
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<h1>@Model.Name</h1>

<p>@Model.Description</p>

@if(Model.ProductIngredients != null && Model.ProductIngredients.Any())
{
    <h4>Products</h4>
    <table class="table">
        <thead>
            <tr>
                <th>Product Name</th>
                <th>Description</th>
                <th>Price</th>
            </tr>
        </thead>

        <tbody>
            @foreach (ProductIngredient pi in Model.ProductIngredients)
            {
                <tr>
                    <td>@pi.Product.Name</td>
                    <td>@pi.Product.Description</td>
                    <td>@pi.Product.Price</td>
                </tr>
            }
        </tbody>
    </table>
    <ul>
        
    </ul>
}

<div>
    <a asp-action="Index">Back to List</a>
</div>

